<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Soft gradient background -->
    <gradient
        android:startColor="#FCE4EC"
        android:centerColor="#FFFFFF"
        android:endColor="#E1F5FE"
        android:angle="270" />

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Pink border for highlight -->
    <stroke
        android:width="2dp"
        android:color="@color/pink_primary" />

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />

</shape>